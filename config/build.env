# Build settings shared by the ISO and Raspberry Pi targets.
# Any of these can also be overridden for one run, e.g.  K8S_VERSION=v1.36 ./build.sh server

# Ubuntu release to build from. Changing this one line updates both targets.
UBUNTU_VERSION=26.04.1

# Where the official images are downloaded from. Point these at a mirror, or at
# https://old-releases.ubuntu.com/releases/... once a point release is superseded.
ISO_BASE_URL="https://releases.ubuntu.com/${UBUNTU_VERSION}"
PI_BASE_URL="https://cdimage.ubuntu.com/releases/${UBUNTU_VERSION}/release"

# The login user created on every machine. Set ADMIN_USER and its password in
# config/secrets.env (see secrets.env.example); this is only the fallback name.
# SSH keys go in config/authorized_keys.
ADMIN_USER=ubuntu

# On first boot each machine renames itself to <prefix>-<last 6 hex digits of its MAC>.
ISO_HOSTNAME_PREFIX=amd-ubuntu-k8s
PI_HOSTNAME_PREFIX=pi-ubuntu-k8s
DESKTOP_HOSTNAME_PREFIX=ubuntu-desktop-vm

LOCALE=en_US.UTF-8
KEYBOARD_LAYOUT=us
TIMEZONE=Etc/UTC

# SSH password logins. Public keys go in config/authorized_keys (one per line).
#   auto   server ISO and Pi: keys present -> keys only, passwords disabled
#          (PasswordAuthentication no); no keys -> passwords allowed.
#          Desktop ISO: passwords stay allowed (it's a local VM).
#   false  keys only on every image (needs at least one key)
#   true   always allow passwords
# Console logins with the password always work, whatever this is set to.
SSH_ALLOW_PASSWORD=auto

# Kubernetes minor release to install from pkgs.k8s.io.
K8S_VERSION=v1.37

# ISO and desktop ISO. false: the "Autoinstall Ubuntu ..." boot entry is the default and
# installs WITHOUT asking, erasing the largest disk. true: no extra boot entry;
# the installer finds the config but asks "Continue with autoinstall?" first.
ISO_REQUIRE_CONFIRMATION=false

# ISO and desktop ISO. Seconds the boot menu waits before starting the first entry.
# 0 = start the install immediately (handy for VMs; the menu isn't shown).
# Leave empty to keep Ubuntu's default of 30 seconds.
ISO_BOOT_TIMEOUT=5

# Raspberry Pi only. Extra kernel arguments appended to cmdline.txt. The memory
# cgroup is off by default on Raspberry Pi kernels and kubelet needs it.
PI_KERNEL_ARGS="cgroup_enable=memory cgroup_memory=1"
