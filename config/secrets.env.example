# Copy this file to config/secrets.env (which git ignores) and fill it in.
# These settings create the login user on every machine built from the images.

# Username. Lowercase letters, digits, _ and -. The Ubuntu installer refuses
# system names such as admin, root, sudo and adm; the build checks this for you.
# This overrides ADMIN_USER in build.env.
ADMIN_USER=ubuntu

# Password, in plain text. The build hashes it with openssl (SHA-512, random
# salt) and only the hash goes into the images; you never handle the hash.
# Use single quotes if it contains $, spaces, or quotes.
ADMIN_PASSWORD='change-me'

# Optional alternative: leave ADMIN_PASSWORD out and give a ready-made hash, so
# the plain password is never stored on disk. ADMIN_PASSWORD wins if both are
# set. Generate one with:
#   openssl passwd -6
# PASSWORD_HASH='$6$...'
