# Copy this file to config/secrets.env (which git ignores) and fill it in.
# These settings create the users on the machines built from the images.
#
# Usernames: lowercase letters, digits, _ and -. The Ubuntu installer refuses
# system names such as admin, root, sudo and adm; the build checks this for you.
# Values here override the defaults in config/build.env.

# The password user, on all three images. SSH keys: config/authorized_keys.
ADMIN_USER=ubuntu

# The key-only user, on the server ISO and Raspberry Pi: no password, sudo
# without a prompt, SSH keys from config/nosshpw_authorized_keys. Change the
# name here, or leave it empty (NOSSHPW_USER=) to create no second user.
NOSSHPW_USER=nosshpw

# Password, in plain text. The build hashes it with openssl (SHA-512, random
# salt) and only the hash goes into the images; you never handle the hash.
# Use single quotes if it contains $, spaces, or quotes.
ADMIN_PASSWORD='change-me'

# Optional alternative: leave ADMIN_PASSWORD out and give a ready-made hash, so
# the plain password is never stored on disk. ADMIN_PASSWORD wins if both are
# set. Generate one with:
#   openssl passwd -6
# PASSWORD_HASH='$6$...'
